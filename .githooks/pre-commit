#!/usr/bin/env python3
"""Pre-commit hook: rejects a commit that puts real data into config.example.json."""
import json
import re
import subprocess
import sys

EXAMPLE_FILE = "config.example.json"
KNOWN_KEYS = {
    "refresh_interval_seconds",
    "recent_tasks_limit",
    "recent_tasks_lookback_days",
    "timesheet_url",
    "language",
}
SUSPICIOUS_VALUE_RE = re.compile(r"wrike\.com|[A-Za-z0-9_-]{30,}")


def staged_content():
    result = subprocess.run(
        ["git", "show", f":{EXAMPLE_FILE}"],
        capture_output=True, text=True,
    )
    return result.stdout if result.returncode == 0 else None


def main():
    raw = staged_content()
    if raw is None:
        return 0

    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        print(f"⚠️  {EXAMPLE_FILE} is not valid JSON in the index: {exc}")
        return 1

    problems = []

    unknown_keys = set(data) - KNOWN_KEYS
    if unknown_keys:
        problems.append(
            f"unexpected key(s) {sorted(unknown_keys)} — {EXAMPLE_FILE} must only "
            "contain placeholders, never a token or real data."
        )

    timesheet_url = data.get("timesheet_url", "")
    if timesheet_url:
        problems.append(
            f"'timesheet_url' is not empty ({timesheet_url!r}) — the expected "
            'placeholder is "".'
        )

    for key, value in data.items():
        if isinstance(value, str) and value and SUSPICIOUS_VALUE_RE.search(value):
            problems.append(
                f"the value of '{key}' looks like real Wrike data/a token: {value!r}"
            )

    if not problems:
        return 0

    print(f"❌ Commit blocked: {EXAMPLE_FILE} appears to contain real confidential data.")
    for problem in problems:
        print(f"   - {problem}")
    print(
        f"\nReal values go in ~/.config/wrike-timer/config.json (gitignored), "
        f"never in {EXAMPLE_FILE}."
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
